# Xcode regenerates this local workspace and user state.
**/*.xcodeproj/project.xcworkspace/

# Retired runtime build outputs may still exist locally.
module/

# Commit the application dependency lock; other generated workspace state stays ignored.
!iOS/AirSIM.xcodeproj/project.xcworkspace/
iOS/AirSIM.xcodeproj/project.xcworkspace/*
!iOS/AirSIM.xcodeproj/project.xcworkspace/xcshareddata/
